# Lock API: environment for every `prod` deployment (roadmap F4 and the deploy/README.md checklist).
#
# Copy this to your secret store or orchestrator config, NOT to a committed file. Values in <> are
# placeholders. Start the API with SPRING_PROFILES_ACTIVE=prod: ProductionSecretsGuard then refuses to
# start while any variable marked [guarded] is missing or still a dev default, so a forgotten variable
# fails the deploy instead of silently skipping malware scans or sending no emails.
# ProductionEnvTemplateTest keeps this file in step with the guard.

SPRING_PROFILES_ACTIVE=prod

# --- Secrets -------------------------------------------------------------------------------------
LOCK_JWT_SECRET=<base64, at least 32 random bytes>          # [guarded]
LOCK_CRYPTO_PROVIDER=aws-kms
LOCK_KMS_KEY_ID=<arn:aws:kms:... or alias/lock-kek>
LOCK_KMS_REGION=<region>
# Only with LOCK_CRYPTO_PROVIDER=local:
# LOCK_MASTER_KEY=<base64, 32 random bytes>                 # [guarded]

# --- Database and storage ------------------------------------------------------------------------
LOCK_DB_URL=jdbc:postgresql://<host>:5432/lock
LOCK_DB_USER=<user>
LOCK_DB_PASSWORD=<password>
LOCK_STORAGE_TYPE=s3
LOCK_S3_ENDPOINT=<https://s3.<region>.amazonaws.com, or empty for AWS defaults>
LOCK_S3_REGION=<region>
LOCK_S3_BUCKET=<bucket, created with object lock, lifecycle from deploy/s3-lifecycle.json (F6)>
LOCK_S3_ACCESS_KEY=<access key>
LOCK_S3_SECRET_KEY=<secret key>                             # [guarded]
LOCK_OBJECT_LOCK_YEARS=100

# --- Malware scanning (F3, F4) ---------------------------------------------------------------------
# clamd must run with deploy/clamd.conf (StreamMaxLength 2100M) or 2 GB videos never pass the scan.
LOCK_SCAN_PROVIDER=clamav                                   # [guarded]
# Rate limits and login lockouts shared by every API instance (table rate_limit_hits, V20).
LOCK_RATE_LIMIT_STORE=postgres                              # [guarded]
LOCK_CLAMAV_HOST=<clamd sidecar host>
LOCK_CLAMAV_PORT=3310

# --- Email and push --------------------------------------------------------------------------------
LOCK_EMAIL_PROVIDER=postmark                                # [guarded]
LOCK_POSTMARK_TOKEN=<postmark server token>
LOCK_EMAIL_FROM=Lock <no-reply@your-domain>
LOCK_RESET_URL=https://<app host>/reset-password
LOCK_PUSH_PROVIDER=expo
LOCK_EXPO_ACCESS_TOKEN=<expo access token>

# --- Media -----------------------------------------------------------------------------------------
LOCK_TRANSCODE_PROVIDER=ffmpeg

# --- Operations ------------------------------------------------------------------------------------
LOCK_MANAGEMENT_PORT=8081          # Prometheus scrapes /actuator/prometheus here; load deploy/prometheus/lock-alerts.yml
LOCK_LOG_FORMAT=ecs
LOCK_FORWARD_HEADERS=framework     # only behind a load balancer that sets X-Forwarded-For
LOCK_CORS_ORIGINS=https://<web app host>
